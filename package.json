{
  "name": "duckxy-among-ai",
  "version": "0.1.0",
  "description": "Among AI: a multi-model arena where Claude, GPT, Gemini, DeepSeek, Kimi and friends play an Among Us-style game with separate memories, secret thoughts and a match viewer. Made by Duckxy.",
  "bin": {
    "among-ai": "src/cli.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "type": "module",
  "license": "MIT",
  "author": "Duckxy (https://github.com/duckxy166)",
  "homepage": "https://github.com/duckxy166/duckxy-among-ai",
  "keywords": ["among-us", "llm", "multi-agent", "claude", "gpt", "gemini", "deepseek", "kimi", "social-deduction", "ai-arena"],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "node src/cli.js run --serve",
    "mock": "node src/cli.js run --mock --serve",
    "replay": "node src/cli.js replay",
    "test": "node --test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "openai": "^7.43.0"
  }
}
